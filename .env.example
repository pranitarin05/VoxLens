# Copy to .env and fill values. NEVER commit .env.

# --- Database (docker-compose postgres service) ---
POSTGRES_USER=voc
POSTGRES_PASSWORD=voc_dev_password
POSTGRES_DB=voc
POSTGRES_PORT=5432

# --- Groq LLM (two keys: primary + automatic backup on auth/quota failure) ---
GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GROQ_MODEL=llama-3.1-8b-instant

# Hard spend cap for ALL LLM call paths (zero-shot eval + RAG generation)
MAX_LLM_SPEND_USD=5.00

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Paths ---
DATABASE_URL=postgresql+psycopg://voc:voc_dev_password@localhost:5432/voc
